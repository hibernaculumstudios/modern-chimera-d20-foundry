{
  "name": "modern-chimera-d20-foundry",
  "version": "0.1.0-dev.1",
  "private": true,
  "type": "module",
  "description": "ModernChimeraD20 game system for Foundry Virtual Tabletop",
  "license": "MIT",
  "engines": {
    "node": ">=22.18.0 <23 || >=24.0.0 <25"
  },
  "scripts": {
    "local:prepare": "node scripts/prepare-local.mjs",
    "build": "node scripts/build.mjs",
    "dev": "node scripts/build.mjs --watch",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "check:repository": "node scripts/check-repository.mjs",
    "check": "npm run typecheck && npm run lint && npm run format:check && npm test && npm run build && npm run check:repository",
    "package": "npm run build && node scripts/package.mjs",
    "hooks:install": "git config core.hooksPath .githooks"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@league-of-foundry-developers/foundry-vtt-types": "14.366.0-beta.20261009164208",
    "@playwright/test": "1.64.0",
    "@types/node": "26.6.4",
    "esbuild": "0.28.2",
    "eslint": "10.12.0",
    "fflate": "0.8.3",
    "globals": "17.13.0",
    "prettier": "3.9.10",
    "typescript": "7.0.2",
    "typescript-eslint": "8.71.1",
    "vitest": "5.0.3"
  }
}
